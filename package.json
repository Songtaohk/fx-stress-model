{
  "name": "fx-stress-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "data:fx": "node scripts/updateFxHistory.mjs",
    "data:recent": "node scripts/updateRecentData.mjs",
    "data:refresh": "npm run data:fx && npm run data:recent"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "echarts": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
